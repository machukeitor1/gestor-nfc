<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GestorNFC" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash (API de SplashScreen; funciona igual desde Android 8 hasta 15+). -->
    <style name="Theme.GestorNFC.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.GestorNFC</item>
    </style>
</resources>
